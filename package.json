{
  "name": "humantxt",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @humantxt/site",
    "build": "npm run build -w @humantxt/core && npm run build -w @humantxt/site",
    "test": "npm test -w @humantxt/core",
    "ext:dev": "npm run dev -w @humantxt/extension",
    "ext:build": "npm run build -w @humantxt/extension"
  }
}
