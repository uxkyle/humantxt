{
  "name": "@humantxt/extension",
  "version": "0.1.0",
  "description": "Keep your human.txt in your browser and share the right layer with the right site.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare",
    "test:e2e": "wxt build && playwright test"
  },
  "dependencies": {
    "@humantxt/core": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "wxt": "^0.21.4"
  }
}
